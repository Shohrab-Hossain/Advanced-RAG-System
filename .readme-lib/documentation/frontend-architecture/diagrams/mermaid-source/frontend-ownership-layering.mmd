flowchart TD
    subgraph L1["① ENTRY"]
        MAIN(["main.js"]):::se
        APP["App.vue"]:::step
        ROUTER["router/index.js<br/>4 routes · lazy import"]:::step
    end

    subgraph L2["② PAGES — placed by OWNERSHIP · one folder per route, owning its own components"]
        subgraph P1["pages/home/"]
            HOME["HomeView.vue<br/>owns nothing"]:::view
        end
        subgraph P2["pages/chat/"]
            CHATV["ChatView.vue"]:::view
            CHS["ChatHistorySidebar"]:::step
            QI["QueryInput"]:::step
            PT["PipelineTracker"]:::step
            RD["ResultDisplay"]:::step
            SR["StageRow<br/>in PipelineTracker/"]:::leaf
            SC["SourceCard<br/>in ResultDisplay/"]:::leaf
        end
        subgraph P3["pages/knowledge-base/"]
            KBV["KnowledgeBaseView.vue"]:::view
            UP["UploadPanel"]:::step
            IS["IndexStats"]:::leaf
            KBL["KnowledgeBaseList"]:::leaf
        end
        subgraph P4["pages/configuration/"]
            CFGV["ConfigView.vue"]:::view
            LLM["LLMSelector"]:::step
        end
    end

    subgraph L3["③ SHARED — promoted only at a SECOND page consumer"]
        NAV["NavBar.vue<br/>health indicator"]:::step
        MODAL["ModalDialog.vue"]:::step
        FTI["FileTypeIcon.vue<br/>3 consumers · 2 pages"]:::leaf
    end

    subgraph L4["④ store/ — FLAT by kind, no per-capability folders"]
        RAGS["ragStore.js<br/>id 'rag'"]:::ok
        KBS["kbStore.js<br/>id 'knowledgeBase'"]:::ok
        UI["index.js — id 'ui'<br/>pinia + vue ONLY"]:::ok
    end

    subgraph L5["⑤ services/ — FLAT by kind · own axios instance each"]
        RAPI["ragApi.js"]:::gate
        KAPI["kbApi.js"]:::gate
    end

    API(["⑥ Flask API · 8 routes<br/>dev proxy /api → :5000"]):::se

