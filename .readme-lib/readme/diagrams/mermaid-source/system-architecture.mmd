flowchart TD
    subgraph Client ["Browser · localhost:8080"]
      SPA(["Vue 3 SPA<br/>4 routes · 13 components"]):::se
    end
    subgraph Server ["Flask API · localhost:5000"]
      API("8 REST endpoints"):::gate
      PIPE("LangGraph pipeline<br/>8 nodes · daemon thread"):::step
      QUEUE("SSE session queue<br/>one per query"):::step
      RET("retrieval<br/>hybrid search"):::step
      TOOL("external_tools"):::step
      GEN("LLM calls<br/>planner · compress<br/>reason · reflect"):::step
    end
    subgraph Data ["Stores · Backend/data/databases"]
      VEC[("Chroma / FAISS")]:::ext
      BM[("BM25 index")]:::ext
      KG[("NetworkX graph")]:::ext
    end
    subgraph Outside ["External services"]
      DDG("DuckDuckGo"):::ext
      OAI("OpenAI API"):::ext
      OLL("Ollama · 11434"):::ext
    end
    SPA -->|"/api proxy"| API
    API -->|"daemon thread"| PIPE
    PIPE --> RET
    PIPE --> TOOL
    PIPE --> GEN
    PIPE -->|"emit()"| QUEUE
    QUEUE -->|"SSE · 180 s drain"| SPA
    RET --> VEC
    RET --> BM
    RET --> KG
    TOOL --> DDG
    GEN --> OAI
    GEN --> OLL
    classDef se fill:#047857,stroke:#059669,color:#FFFFFF,font-weight:600;
    classDef step fill:#ECFDF5,stroke:#A7F3D0,color:#0F172A;
    classDef gate fill:#DBEAFE,stroke:#3B82F6,color:#0C4A6E,font-weight:600;
    classDef ext fill:#F1F5F9,stroke:#94A3B8,color:#334155;
