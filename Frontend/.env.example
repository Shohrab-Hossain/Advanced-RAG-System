# Vue CLI env vars must be prefixed with VUE_APP_ to be exposed to the browser.
# Copy to .env and adjust if your Flask server runs on a different port/host.
#
# Leave this UNSET (or empty) for normal development: vue.config.js proxies /api/*
# to the backend, so a relative path already works and setting an absolute URL
# only bypasses the proxy. Set it when the frontend is served from a different
# origin than the API.

VUE_APP_API_URL=http://localhost:5000
