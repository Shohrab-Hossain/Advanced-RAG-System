# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg
*.egg-info/
dist/
build/
.eggs/
*.whl

# Local LLMs
.claude

# Virtual environments
my_venv/
venv/
.venv/
env/
.env/

# ── Environment / secrets ─────────────────────────────────────────────────────
.env
*.env
!.env.example

# ── RAG data (runtime, not source) ───────────────────────────────────────────
# DATA_ROOT ("./data") resolves against the process working directory, and both
# main.py and dev.py start the app inside Backend/src/ — so the live stores land
# in Backend/src/data/. The Backend/data/ pair covers a run started one level up.
Backend/src/data/
Backend/data/

# ── Node / Frontend ───────────────────────────────────────────────────────────
node_modules/
Frontend/dist/
Frontend/.env
Frontend/.env.local
Frontend/.env.*.local

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── IDE ───────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.suo
*.user

# ── Misc ──────────────────────────────────────────────────────────────────────
*.bak
*.tmp
*.swp
